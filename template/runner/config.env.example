# Copy thành runner/config.env (đã gitignore) trên TỪNG máy rồi chỉnh.
#
# Khâu BẮT BUỘC (luôn chạy, không tắt được): lập kế hoạch (tasks có Acceptance),
# tự chấm điểm (eval/checks.sh + reviewer độc lập + phát hiện sửa vùng bảo vệ),
# kiểm thử (test ẩn từng task + kiểm thử cấp epic).
# Mọi khâu khác là TUỲ CHỌN — chỉ chạy khi bạn gọi hoặc bật ở dưới (để tiết kiệm token).

# ═══════════════ AGENT ═══════════════
# kit.py chạy với mọi agent:
#   auto   = claude nếu máy có Claude Code → cli nếu đặt AGENT_CMD → chat
#   claude = Claude Code CLI (có rào cứng bằng hooks)
#   cli    = agent CLI khác, lệnh đặt ở AGENT_CMD; {prompt} được thay bằng prompt (một tham số),
#            không có {prompt} thì prompt được đưa qua stdin. Ví dụ (kiểm tra cú pháp CLI của bạn):
#              AGENT_CMD=copilot -p {prompt} --allow-all-tools
#   chat   = không có CLI (Copilot Chat trong VS Code...): bảo agent trong chat chạy
#            `python3 runner/kit.py work` và làm theo từng bước nó in ra
AGENT=auto
AGENT_CMD=
# (AGENT=claude) Đường dẫn tới claude. Khi chạy theo lịch nên dùng đường dẫn tuyệt đối: which claude
CLAUDE_BIN=claude

# ═══════════════ BẮT BUỘC: chấm điểm & kiểm thử ═══════════════
# Nhánh gốc: mỗi task tạo nhánh agent/<id>-a<n> từ đây, PR mở về đây
BASE_BRANCH=main
# Bài kiểm tra ẩn: NGOÀI repo, agent làm bài không bao giờ thấy. Trống = ~/.agent-holdout/<tên project>.
# Cấu trúc: $HOLDOUT_DIR/<task-id>/<đường dẫn y như trong repo, vd tests/test_x.py>
HOLDOUT_DIR=
# Lệnh chạy test ẩn trong thư mục làm việc (bắt buộc nếu có task holdout: true)
HOLDOUT_CMD="pytest -q tests"
# Lệnh chạy kiểm thử end-to-end cấp epic (trống = dùng HOLDOUT_CMD)
EPIC_TEST_CMD=
# Số lần thử lại một task bị chấm FAIL (lần sau được biết lý do lần trước)
MAX_ATTEMPTS=2

# ═══════════════ TUỲ CHỌN: chi phí & nhịp làm việc ═══════════════
# Số task tối đa mỗi phiên `work`, và thời gian tối đa cho một task
MAX_TASKS=3
TASK_TIMEOUT_MIN=60
# Phanh an toàn theo chi phí ƯỚC TÍNH mỗi lần gọi agent (USD). Trống = tắt.
MAX_BUDGET_USD=
# 1 = bắt buộc có PRD đã duyệt trước khi `plan`. 0 = PRD tuỳ chọn (mặc định)
REQUIRE_PRD=0

# Tiết kiệm token (tuỳ chọn, mặc định tắt). Proxy nén context (vd Headroom): đặt địa chỉ proxy,
# kit.py chuyển nó thành ANTHROPIC_BASE_URL cho agent con. Trống = gọi thẳng.
# (RTK, code-review-graph: cài riêng theo hướng dẫn của công cụ, xem README mục 8.3)
ANTHROPIC_BASE_URL=

# ═══════════════ TUỲ CHỌN: GitHub & nhiều máy ═══════════════
# GitHub Issues + Pull Request qua `gh` (cần: gh auth login). 1 = bật
GH_SYNC=1
# Tự `git pull --ff-only` đầu mỗi phiên `work`. Pull thất bại → DỪNG, không chạy spec cũ.
GIT_PULL=1
# Chia sẻ trạng thái + log lên nhánh git riêng (không đụng nhánh code) để máy khác
# chạy `kit.py status/report/doctor` thấy đúng. 1 = bật
PUBLISH=1
LOG_BRANCH=agent-kit/log
# Tên máy hiển thị trong báo cáo (trống = hostname). Mỗi máy phải khác nhau.
MACHINE_NAME=
# Khoá chống 2 máy cùng chạy `work`; tự hết hạn sau số giờ này (phiên bị chết giữa chừng)
LOCK_HOURS=12
# Chỉ dùng nếu bạn đặt lịch chạy tự động: doctor cảnh báo khi một máy quá số giờ này chưa chạy. Trống = tắt.
STALE_RUN_HOURS=

# ═══════════════ TUỲ CHỌN: thông báo ═══════════════
# Gửi tóm tắt sau mỗi phiên `work` qua Telegram (trống = chỉ ghi file)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
