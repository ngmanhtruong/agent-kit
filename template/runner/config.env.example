# Copy thành runner/config.env (đã gitignore) trên TỪNG máy rồi chỉnh.

# Nhánh gốc: mỗi task tạo nhánh agent/<id>-a<n> từ đây, PR mở về đây
BASE_BRANCH=main

# Gói Pro có giới hạn theo cửa sổ thời gian → ít task, tuần tự.
MAX_TASKS=3
TASK_TIMEOUT_MIN=60
# Số lần thử lại khi bị chấm FAIL (lần sau được biết lý do lần trước)
MAX_ATTEMPTS=2

# Phanh an toàn chống agent chạy vòng lặp (USD ƯỚC TÍNH, không phải hoá đơn Pro). Trống = tắt.
MAX_BUDGET_USD=

# Đường dẫn tuyệt đối tới claude — cron không có PATH đầy đủ. Lấy bằng: which claude
CLAUDE_BIN=claude

# Bài kiểm tra ẩn: NGOÀI repo, worker không bao giờ thấy.
# Cấu trúc: $HOLDOUT_DIR/<task-id>/<đường dẫn y như trong repo, vd tests/test_x.py>
# Runner chép vào worktree sau khi worker xong, chạy HOLDOUT_CMD, rồi xoá.
HOLDOUT_DIR="$HOME/.agent-holdout/my-project"
HOLDOUT_CMD="pytest -q tests"

# Reviewer độc lập (thêm 1 lượt gọi mỗi task). 1 = bật
REVIEW=1

# GitHub Issues + Pull Request qua `gh` (cần: gh auth login). 1 = bật
GH_SYNC=1
# Tự `git pull --ff-only` đầu mỗi phiên `run` (để nhận task vừa được duyệt ở máy khác).
# Pull thất bại (máy này có commit chưa push / file chưa commit) → DỪNG, không chạy spec cũ.
GIT_PULL=1

# Chia sẻ trạng thái + log mỗi lượt chạy lên nhánh git riêng (không đụng nhánh code),
# để máy khác chạy `kit.py status/report/doctor` thấy đúng những gì đã xảy ra. 1 = bật
PUBLISH=1
LOG_BRANCH=agent-kit/log
# Tên máy hiển thị trong báo cáo (trống = hostname). Mỗi máy phải khác nhau.
MACHINE_NAME=
# Khoá chống 2 máy cùng chạy `run` một lúc; tự hết hạn sau số giờ này (phiên bị chết giữa chừng)
LOCK_HOURS=12
# Chỉ dùng nếu bạn đặt lịch chạy tự động: doctor cảnh báo khi một máy quá số giờ này chưa chạy phiên nào.
# Trống = tắt.
STALE_RUN_HOURS=

# Gửi tóm tắt sau mỗi phiên `run` qua Telegram (trống = chỉ ghi file)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
